# Template for local development. Copy to .env.local and fill in.
# .env.local is gitignored; .env.example is committed.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knockknock_dev
DB_USER=postgres
DB_PASSWORD=

# SQLAlchemy / psycopg DSN (sync, used by Alembic and most code paths)
KNOCKKNOCK_DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/knockknock_dev

# Asyncpg DSN (used by async code paths)
KNOCKKNOCK_DATABASE_URL_ASYNC=postgresql+asyncpg://<user>:<password>@localhost:5432/knockknock_dev

# Raw psql-style URL
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/knockknock_dev

# --- Filled in during later phases ---
# GEMINI_API_KEY=
# APOLLO_API_KEY=
# HUNTER_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_CALLBACK_SECRET=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
